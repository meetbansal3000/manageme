# ==============================================================================
# manageme Environment Configuration Template
# Copy this file to .env or .env.local and fill in your actual credentials.
# NEVER commit .env or .env.local to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI & LLM PROVIDER CREDENTIALS (Server-side recommended)
# ------------------------------------------------------------------------------
# Google Gemini API Key: Required for core AI Copilot, Chat, and OCR extraction
GEMINI_API_KEY=""
# Optional client-side mirror if running in standalone Vite preview
VITE_GEMINI_API_KEY=""

# OpenAI API Key: Required for GPT-4o / o3-mini access
OPENAI_API_KEY=""

# Anthropic API Key: Required for Claude 3.5 Sonnet / Haiku
ANTHROPIC_API_KEY=""

# DeepSeek API Key: Required for DeepSeek V3 / R1 reasoning
DEEPSEEK_API_KEY=""

# ------------------------------------------------------------------------------
# 2. DATABASE & SUPABASE CONFIGURATION (Client-Safe via Row Level Security)
# ------------------------------------------------------------------------------
# Supabase Project URL & Anon/Publishable Key
# IMPORTANT: Ensure Row Level Security (RLS) is enabled on all tables before exposing anon key
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-publishable-key"

# ------------------------------------------------------------------------------
# 3. FIREBASE CONFIGURATION (Client-Safe Public App Configuration)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="manageme-9fccc.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="manageme-9fccc"
VITE_FIREBASE_STORAGE_BUCKET="manageme-9fccc.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID="(default)"

# ------------------------------------------------------------------------------
# 4. TRANSIT & MAPPING APIS
# ------------------------------------------------------------------------------
# Transport for London (TfL) Unified API Key
VITE_TFL_APP_KEY=""

# Geoapify Routing & Places API Key
VITE_GEOAPIFY_API_KEY=""

# Google Maps Platform API Key (for Live Transit Map & Street View)
VITE_GOOGLE_MAPS_API_KEY=""
GOOGLE_MAPS_PLATFORM_KEY=""

# Navitia Transit API Token
VITE_NAVITIA_TRANSIT_TOKEN=""

# ------------------------------------------------------------------------------
# 5. FINANCIAL MARKET & NEWS APIS (Server-Side Ingestion)
# ------------------------------------------------------------------------------
# Finnhub Stock API Token
FINNHUB_API_KEY=""

# Marketaux News & Sentiment API Token
MARKETAUX_API_KEY=""

# Alpha Vantage Market Intelligence API Key
ALPHA_VANTAGE_API_KEY=""

# The Guardian Open Platform Content API Key
GUARDIAN_API_KEY=""

# Yahoo Finance / RapidAPI Key
RAPIDAPI_KEY=""
YAHOO_FINANCE_API_KEY=""

# ------------------------------------------------------------------------------
# 6. APP SECURITY & SYSTEM SETTINGS
# ------------------------------------------------------------------------------
# Base App URL
APP_URL="http://localhost:3000"

# Optional Workspace Master PIN (4+ digits). If omitted, Master Google Auth is required.
VITE_MASTER_PIN=""

# Development server HMR toggle (set to 'true' to disable overlay)
DISABLE_HMR=""
