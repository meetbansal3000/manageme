{
  "collections": [
    {
      "name": "users",
      "document": {
        "fields": [
          { "name": "email", "type": "string" },
          { "name": "createdAt", "type": "timestamp" },
          { "name": "settings", "type": "map" }
        ]
      },
      "rules": {
        "read": "request.auth != null && request.auth.uid == id",
        "write": "request.auth != null && request.auth.uid == id"
      }
    },
    {
      "name": "timeline",
